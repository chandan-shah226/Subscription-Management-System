# Brightloop Software - Environment Configuration Template
# Copy this file to .env and adjust values for local development.

# Application Environment (development, testing, production)
FLASK_ENV=development
SECRET_KEY=dev-secret-key-brightloop-subscription-system-2026-safe-32-bytes
JWT_SECRET_KEY=dev-jwt-secret-key-brightloop-subscription-system-2026-safe-32-bytes

# Database Configuration (Defaults to instance/subscription_system.db)
DATABASE_URL=sqlite:///instance/subscription_system.db

# Module 6: Razorpay Payment Gateway (Test Mode ONLY)
# Obtain your test API keys from Razorpay Dashboard -> Settings -> API Keys (https://dashboard.razorpay.com/#/app/keys)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret
RAZORPAY_MODE=test

# Optional Email / SMTP configuration (for sending invoice PDFs)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=billing@brightloop.com
